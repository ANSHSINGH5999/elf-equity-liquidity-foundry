# ELF — Equity Liquidity Foundry
# Copy to .env and fill in. Never commit the real .env file.

# --- Database (server-only) ---
# Local: docker compose up -d, then use the value below.
# Hosted: use your Neon/Supabase connection string.
DATABASE_URL="postgresql://elf:elf@localhost:5432/elf?schema=public"

# --- Solana RPC (server-only; may embed an API key) ---
SOLANA_RPC_URL="https://api.devnet.solana.com"

# --- Solana RPC (public; sent to the browser, must never contain a secret) ---
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"

# --- Absolute base URL of this deployment, used to build token metadata URIs ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- PreStocks (public, unauthenticated API; override only for testing) ---
PRESTOCKS_API_URL="https://prestocks.com/api/prestocks"

# --- Tessera (P2, feature-flagged, disabled by default — see docs/architecture.md) ---
TESSERA_ENABLED="false"
TESSERA_API_URL="https://rest-api.tessera.pe/v1/public/token-details"

# --- Pyth Hermes (server-only): required for live price-oracle comparison. ---
# Get a free key at https://pyth.network (Pyth Pro developer portal) — the
# Hermes /v2/updates/price/latest endpoint requires a Bearer token as of the
# current API version. Without this set, getPythReferencePrice()/
# getPythPriceComparison() return null and the UI falls back to the
# issuer-declared reference price — never an error, just less data.
PYTH_API_KEY=""
PYTH_HERMES_URL="https://hermes.pyth.network"

# --- Indexer (server-only): shared secret for POST /api/indexer/run. ---
# If unset outside production (NODE_ENV != "production"), the endpoint is
# unauthenticated — a deliberate, documented local-dev convenience. If unset
# WITH NODE_ENV=production, the endpoint fails closed (500) instead of
# running unauthenticated. See docs/security-remediation.md (LOW-3).
INDEXER_SECRET=""

# --- Rate limiting (server-only): how far to trust X-Forwarded-For. ---
# The in-memory rate limiter (apps/web/src/lib/server/rate-limit.ts) is
# per-instance and advisory by design (see docs/security.md) — it cannot
# be made fully robust without a shared store. Separately, whether its
# per-caller *identity* is trustworthy depends on whether a real reverse
# proxy in front of this app overwrites/appends X-Forwarded-For, which
# this app cannot know on its own. Leave unset (0) to NOT trust any
# client-supplied header — every caller collapses onto the same bucket,
# which is safe (not spoofable) but only throttles total traffic, not
# per-client abuse. Set to the number of trusted reverse proxies between
# the client and this app (Vercel: 1) to use the corresponding hop's
# X-Forwarded-For entry as the rate-limit identity — only do this if you
# have verified your platform actually sets/overwrites that header itself.
# See docs/security-remediation.md (LOW-4) for the full threat model.
TRUSTED_PROXY_HOPS="0"

# --- Integration tests only: a base58 secret key for a pre-funded devnet wallet. ---
# Lets tests/integration/meteoraAdapter.test.ts run its real send/confirm steps
# without depending on the public devnet faucet's rate limit. Never a mainnet key.
TEST_FUNDED_KEYPAIR_SECRET=""
